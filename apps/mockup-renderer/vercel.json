{
  "git": {
    "deploymentEnabled": {
      "feature/rel8tion-funnel-review-2026-11-04": false,
      "feature/buyer-ai-paid-agent-slice-2026-11-06": false
    }
  },
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/render-agent-mockup.ts": {
      "memory": 1024,
      "maxDuration": 90,
      "includeFiles": "node_modules/{sharp,@img}/**/*"
    },
    "api/cron-generate.ts": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/cron-render.ts": {
      "memory": 256,
      "maxDuration": 90
    },
    "api/cron-send.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron-generate",
      "schedule": "1,11,21,31,41,51 * * * *"
    },
    {
      "path": "/api/cron-render",
      "schedule": "3,13,23,33,43,53 * * * *"
    }
  ]
}
